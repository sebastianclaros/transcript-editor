{
  "name": "@transcript-editor/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Transcript Editor desktop app (Electron)",
  "main": "out/main/index.cjs",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Sebastian Claros",
    "email": "noreply@users.noreply.github.com"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "dist:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux",
    "dist:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "test:e2e": "node scripts/run-e2e.mjs",
    "docs:screenshots": "E2E_SCREENSHOTS=1 node scripts/run-e2e.mjs e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.65.0",
    "@transcript-editor/core": "*",
    "@transcript-editor/storage": "*",
    "@transcript-editor/ui": "*",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "41.3.0",
    "electron-builder": "25.1.8",
    "electron-vite": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.4.5",
    "zod": "3.25.76"
  }
}
