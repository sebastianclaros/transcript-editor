# Build-time variables. Copy to `.env` (git-ignored) only if you build a version with Google Drive.
# Not used by v0.1: there is no Google API code yet (see docs/drive-sync-design.md).
# The OAuth Client ID of a Desktop app is public, not a secret, but it is injected at build time,
# not stored in config.json. Forks use their own.
GOOGLE_CLIENT_ID=
