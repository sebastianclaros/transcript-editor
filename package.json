{
  "name": "transcript-editor-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first desktop editor to correct interview transcripts while listening to the audio.",
  "homepage": "https://github.com/sebastianclaros/transcript-editor",
  "license": "Apache-2.0",
  "author": {
    "name": "Sebastian Claros",
    "email": "noreply@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianclaros/transcript-editor.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @transcript-editor/desktop",
    "build": "npm run build -w @transcript-editor/desktop",
    "dist": "npm run dist -w @transcript-editor/desktop",
    "dist:dir": "npm run dist:dir -w @transcript-editor/desktop",
    "dist:linux": "npm run dist:linux -w @transcript-editor/desktop",
    "dist:mac": "npm run dist:mac -w @transcript-editor/desktop",
    "dist:win": "npm run dist:win -w @transcript-editor/desktop",
    "test": "vitest run --coverage",
    "test:e2e": "npm run test:e2e -w @transcript-editor/desktop",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:privacy": "node scripts/privacy-scan.mjs",
    "check:kiro": "node scripts/check-kiro.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:privacy && npm run check:kiro && npm run check:links"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
